{
  "name": "last-knight-launcher",
  "productName": "Last Knight Launcher",
  "version": "1.0.0",
  "description": "Kingdom's Last Knight \u2014 download, play offline, update when you choose.",
  "author": "Restful Knight Gaming",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.restfulknight.lastknight.launcher",
    "productName": "Last Knight Launcher",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "icon.png",
      "ui/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Kingdom's Last Knight"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "public.app-category.games",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "icon.png",
      "category": "Game"
    },
    "artifactName": "LastKnight-Launcher-${os}.${ext}",
    "publish": null
  },
  "repository": "https://github.com/zkleppe-alt/3dlumi"
}